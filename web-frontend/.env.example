# API Base URL for RailSafe backend
# In local development: http://localhost:5000 (or leave empty if using Vite proxy)
# In production on Vercel: leave empty to use relative /api routes
VITE_API_URL=http://localhost:5000

# Optional client-side fallback API key for direct RailRadar requests
# Note: In production, live requests should always proxy via backend
VITE_RAILRADAR_API_KEY=
