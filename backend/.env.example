# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=*

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here

# Third-party Live Railway Tracking Telemetry (RailRadar)
RAILRADAR_API_KEY=your_railradar_api_key_here

# Database Configuration (MySQL)
# If using a full connection string:
# DATABASE_URL=mysql://root:password@localhost:3306/railsafe
# Or discrete parameters:
DB_HOST=localhost
DB_PORT=3306
DB_NAME=railsafe
DB_USER=root
DB_PASSWORD=your_mysql_password_here

# Debug Flags
DEBUG_RAILWAY_DISTANCE=false
